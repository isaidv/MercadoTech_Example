# Variables de entorno de MercadoTech.
#
# Copia este archivo a `.env.local` — y SOLO a `.env.local` — y completa los
# valores reales. NUNCA crear también un `.env` plano con otros valores:
# Next.js carga `.env` y `.env.local` a la vez, y `.env.local` gana en lo que
# se repite — un `.env` paralelo no es un "fallback", es un segundo lugar
# donde el mismo valor puede quedar desactualizado en silencio (ya pasó una
# vez: `.env` apuntaba al proyecto cloud y `.env.local` a local, sin ningún
# error que lo avisara). Un solo archivo de entorno local, siempre.

# --- Runtime de la app (Next.js) ---
# Para desarrollo día a día: valores del Supabase LOCAL (`supabase start`
# los imprime; también quedan en `supabase status -o env`).

# URL del proyecto de Supabase. Pública: se expone al navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon". Pública: se expone al navegador. Todas las
# operaciones hechas con ella respetan Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de "service role". SECRETA: nunca debe llevar el prefijo
# NEXT_PUBLIC_ ni exponerse al navegador. Bypasea RLS por completo.
# Solo la usa lib/supabase/admin.ts desde código server-only.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada para construir enlaces absolutos, redirects
# de auth, etc.). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo para el Supabase CLI (link/push a un proyecto cloud) ---
# La app Next.js NUNCA lee estas dos — no confundir con las de arriba.
# Sin ellas, todo lo demás funciona igual: solo hacen falta si vas a correr
# `supabase link` / `supabase db push` contra un proyecto real.

# Personal, de https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Contraseña de Postgres del proyecto cloud (Project Settings → Database).
# Si contiene un '#' u otro carácter especial, ponela entre comillas simples.
SUPABASE_DB_PASSWORD=

# --- IA (sesión 4) ---
# Son DOS proveedores porque la API de Claude no genera embeddings: Anthropic
# no tiene modelo propio de embeddings y recomienda Voyage AI. Claude redacta,
# Voyage vectoriza. Ambas SECRETAS: solo servidor, nunca con prefijo
# NEXT_PUBLIC_. Ver "Antes de empezar" en MercadoTech_sesion4.md para cómo
# conseguir cada una.

# Chat del asistente (claude-haiku-4-5), vía @anthropic-ai/sdk. La provee el
# curso — https://console.anthropic.com si hace falta generar la propia.
ANTHROPIC_API_KEY=

# Embeddings (voyage-4-lite, 1024 dims), vía fetch a
# https://api.voyageai.com/v1/embeddings. Se crea gratis en
# https://dashboard.voyageai.com (Organization → API keys).
VOYAGE_API_KEY=

# Opcional: override deliberado del modelo de chat. Sin esto, el fallback es
# la constante en lib/constants/ai.ts ("claude-haiku-4-5", sin sufijo de fecha).
ANTHROPIC_CHAT_MODEL=

# Opcional: override deliberado del modelo de embeddings. Cambiarlo a un
# modelo con otra dimensión exige migración (la columna vector(1024) queda
# grabada en SQL) — no alcanza con tocar esta variable.
VOYAGE_EMBEDDING_MODEL=
